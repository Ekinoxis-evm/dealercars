# ---------------------------------------------------------------- Privy (auth)
# Privy owns the session; Supabase owns the record. Wallets are disabled in the
# provider config — this app needs a bank account for ACH, not a wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional but recommended. Privy dashboard -> App settings -> Verification key.
# Without it, every authenticated request makes a network call to Privy to fetch
# the signing key; with it the token is verified locally. Not a secret (it is a
# public key), but nothing in the browser needs it.
PRIVY_VERIFICATION_KEY=

# ------------------------------------------------------------- Supabase (data)
NEXT_PUBLIC_SUPABASE_URL=
# Service role bypasses RLS. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ Stripe (payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Nothing is billed on the platform account. Every charge is a direct charge on
# the dealer's connected account: the visit deposit, the down payment, and each
# installment. There is no subscription and no price ID to configure.

# ------------------------------------------------------------------------ site
# Must be the real https origin in production: Stripe redirects back to it and
# Apple Pay will not appear on an http origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------- dealer operations
# Admin access is no longer an env var. It is a row in the `admins` table keyed
# by Privy DID (migration 0003), so it can be granted and revoked per person and
# an inventory change can be traced to one. Insert the first admin by hand:
#
#   insert into admins (privy_did, label) values ('did:privy:...', 'Your name');
