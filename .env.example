# ---------------------------------------------------------------- Privy (auth)
# Privy owns the session; Supabase owns the record. Wallets are disabled in the
# provider config — this app needs a bank account for ACH, not a wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ------------------------------------------------------------- Supabase (data)
NEXT_PUBLIC_SUPABASE_URL=
# Service role bypasses RLS. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Created by `npm run stripe:catalog`. Platform account, our own revenue.
STRIPE_MEMBERSHIP_PRICE_ID=

# ------------------------------------------------------------------------ site
# Must be the real https origin in production: Stripe redirects back to it and
# Apple Pay will not appear on an http origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
