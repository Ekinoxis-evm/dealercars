# ------------------------------------------------------------- Supabase (data + auth)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: reads nothing under deny-all RLS. The browser uses it for the
# auth session (email code / link) and nothing else.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role bypasses RLS. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------ site
# Must be the real https origin in production: the sign-in link and Stripe both
# redirect back to it, and Apple Pay will not appear on an http origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------- Google Places (optional)
# Address suggestions on the profile form. Restrict the key to this site's
# origins and to the Places API (New). Without it the form still works: a ZIP
# fills city and state, and the street is typed by hand.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------ Stripe (payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin access is a row in `admins`, added by email from /admin/admins. There is
# no admin password and no admin env var.
